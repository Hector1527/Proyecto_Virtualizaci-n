# Copy to secrets/database.secret; fill locally. Values are unquoted.
# Environment variables take precedence over this file. Never commit secrets.
# Users: PostgreSQL identifiers, all four distinct.
# Passwords: letters, numbers, period, underscore or hyphen; random hex works.
POSTGRES_ADMIN_USER=
POSTGRES_ADMIN_PASSWORD=
INVENTARIO_DB_USER=
INVENTARIO_DB_PASSWORD=
CLIENTES_DB_USER=
CLIENTES_DB_PASSWORD=
PEDIDOS_DB_USER=
PEDIDOS_DB_PASSWORD=
