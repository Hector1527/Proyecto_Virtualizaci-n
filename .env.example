# Postgres - usuario administrador del motor
POSTGRES_ADMIN_USER=admin
POSTGRES_ADMIN_PASSWORD=cambia_esto

# Base y usuario del servicio inventario
INVENTARIO_DB_NAME=inventario_db
INVENTARIO_DB_USER=inventario_user
INVENTARIO_DB_PASSWORD=cambia_esto

# Base y usuario del servicio clientes
CLIENTES_DB_NAME=clientes_db
CLIENTES_DB_USER=clientes_user
CLIENTES_DB_PASSWORD=cambia_esto

# Base y usuario del servicio pedidos
PEDIDOS_DB_NAME=pedidos_db
PEDIDOS_DB_USER=pedidos_user
PEDIDOS_DB_PASSWORD=cambia_esto

# Parámetros de negocio; coincide con el Backend actual
UMBRAL_STOCK_BAJO=10

# Publicación en Docker Hub (namespace del grupo y versión de las imágenes)
DOCKERHUB_USER=usuario_del_grupo
TAG=1.0
